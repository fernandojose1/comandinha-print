{
  "name": "comandinha-print",
  "version": "0.1.0",
  "description": "Print agent for Comandinha SaaS — bridges cloud backend to local ESC/POS printer",
  "main": "index.js",
  "bin": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "bash scripts/build.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "vitest": "^1.6.0",
    "@yao-pkg/pkg": "^5.12.0"
  },
  "pkg": {
    "targets": ["node20-win-x64", "node20-macos-x64", "node20-linux-x64"],
    "outputPath": "bin"
  }
}
